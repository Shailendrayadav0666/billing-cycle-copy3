{
  "evalFrameworkVersion": "1.0.0",
  "scope": "changed-files",
  "retryLimitForSelfRepair": 3,
  "thresholds": {
    "lintErrorsAllowedDelta": 0,
    "typeErrorsAllowed": 0,
    "semgrepFindingsAllowed": {
      "critical": 0,
      "high": 0,
      "medium": 5
    },
    "dependencyVulnerabilitiesAllowed": {
      "critical": 0,
      "high": 0
    },
    "disallowedLicenses": [
      "GPL-2.0",
      "GPL-3.0",
      "AGPL-3.0",
      "SSPL-1.0"
    ],
    "maxCyclomaticComplexity": 12,
    "secretFindingsAllowed": 0,
    "unitTestCoverageMin": 90.0,
    "behaviorScenarioPassRateMin": 100.0,
    "llmJudgeArchitectureScoreMin": 0.85,
    "llmJudgeSecurityScoreMin": 0.85,
    "securityVulnerabilitiesAllowed": 0
  },
  "behavior": {
    "containerRuntime": "podman",
    "image": "aire-behavior:local",
    "containerfile": "tests/.evals/behavior/Containerfile",
    "entrypoint": "tests/.evals/behavior/run.sh",
    "_comment": "Same image + command locally and in CI. A missing runtime degrades to native execution, recorded, never blocking."
  },
  "sonarqube": {
    "enabled": false,
    "_comment": "Set true when CI generation creates sonar-project.properties and the user answers proceed at the setup gate. Additive to semgrep, never a replacement."
  },
  "playwright": {
    "enabled": false,
    "startCommand": null,
    "readinessUrl": null,
    "testCommand": "npx playwright test tests/e2e/",
    "backendStartCommand": null,
    "backendReadinessUrl": null,
    "_comment": "Set true, with startCommand/readinessUrl resolved, the first time a work unit runs the Playwright UI Automation Gate for real (implementation/code-generation.md Step 11d). testCommand is stored WITHOUT a display flag."
  },
  "judge": {
    "model": "claude-opus-5-5",
    "rubricVersion": "1.0.0"
  },
  "ci": {
    "baseBranch": "main",
    "integrationBranchPrefixes": [
      "epic",
      "bug",
      "enh",
      "ci",
      "story",
      "ve"
    ],
    "manifestState": "resolved",
    "roots": [
      {
        "root": "src/backend",
        "stack": "python",
        "runtimeVersion": "3.13",
        "markerFile": "requirements.txt",
        "installCommands": [
          "pip install -r requirements.txt"
        ],
        "buildCommand": null,
        "coverageCommand": "pytest --cov=. --cov-report=xml",
        "noTestsExitCode": 5,
        "dependsOn": [],
        "toolchainSetup": [],
        "coverageReportPath": "coverage.xml",
        "coverageFormat": "cobertura",
        "sourcePaths": [
          "src/backend"
        ],
        "testPaths": [
          "tests/unit/backend",
          "tests/behavior"
        ],
        "tools": [
          "semgrep",
          "pip-audit",
          "gitleaks"
        ],
        "toolInstallCommands": {
          "semgrep": "pip install \"semgrep==1.127.0\"",
          "pip-audit": "pip install \"pip-audit==2.9.0\"",
          "gitleaks": "gitleaks_version=8.21.2; curl -sSfL \"https://github.com/gitleaks/gitleaks/releases/download/v${gitleaks_version}/gitleaks_${gitleaks_version}_linux_x64.tar.gz\" | tar xz -C /usr/local/bin gitleaks"
        }
      },
      {
        "root": "src/frontend",
        "stack": "node",
        "runtimeVersion": "22.14.0",
        "markerFile": "package.json",
        "installCommands": [
          "npm install"
        ],
        "buildCommand": "npm run build",
        "coverageCommand": "npx vitest run --coverage --passWithNoTests",
        "dependsOn": [],
        "toolchainSetup": [],
        "coverageReportPath": "coverage/lcov.info",
        "coverageFormat": "lcov",
        "sourcePaths": [
          "src/frontend/src"
        ],
        "testPaths": [
          "tests/unit/frontend",
          "tests/e2e"
        ],
        "tools": [
          "oxlint",
          "npm-audit"
        ],
        "toolInstallCommands": {
          "oxlint": "npm install",
          "npm-audit": "npm install"
        }
      }
    ],
    "gates": [
      "D1_lint",
      "D2_types",
      "D3_sast",
      "D4_deps",
      "D5_licenses",
      "D6_complexity",
      "D7_secrets",
      "unitCoverage",
      "behaviorB1",
      "behaviorB2",
      "behaviorB3",
      "J1_architecture",
      "J2_security"
    ],
    "_comment": "CI generation opted out (## CI/CD Configuration Enabled: No); the local gates read this block. Roots detected from the repo: src/backend (requirements.txt, local Python 3.13.3) and src/frontend (package.json, local Node v22.14.0, oxlint already configured)."
  }
}
